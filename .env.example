# =============================================================================
# The Champions Club — environment contract.
# Copy to `.env` (git-ignored) and fill in. NEVER commit real values. NEVER paste real secrets into docs/chat.
# Classification of every variable: docs/integration/ENVIRONMENT.md
#   [FRONTEND-SAFE] may be exposed to the browser (must start with VITE_)
#   [BACKEND-ONLY]  server environment only
#   [SECRET]        backend-only AND sensitive: password / key / token. Rotate if leaked.
# =============================================================================

# ---------- shared ----------
NODE_ENV=development                    # [BACKEND-ONLY] development | production | test
APP_TIMEZONE=Asia/Kolkata               # [BACKEND-ONLY] informational; business logic uses shared/lib/time.ts (IST)

# ---------- backend server ----------
PORT=4000                               # [BACKEND-ONLY]
CORS_ORIGINS=http://localhost:5173      # [BACKEND-ONLY] comma-separated allowed browser origins
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars   # [SECRET] signs access tokens
JWT_EXPIRES_IN=8h                       # [BACKEND-ONLY]
BCRYPT_ROUNDS=10                        # [BACKEND-ONLY]

# ---------- database (LOCAL development: PostgreSQL + pgAdmin) ----------
# Create the database once in pgAdmin (or: createdb champions_club), then:
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/champions_club   # [SECRET] used by backend AND database/*.mjs scripts
DATABASE_SSL=false                      # [BACKEND-ONLY] true for Supabase
ALLOW_DB_RESET=false                    # [BACKEND-ONLY] set true ONLY on your own machine to allow `npm run db:reset`

# ---------- database (CLOUD: Supabase Postgres) — use in the deployed backend's env, NOT in your local .env ----------
# Dashboard -> Project Settings -> Database -> Connection string (use the "Session pooler" or direct string, port 5432, for migrations)
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true

# ---------- Supabase project keys (OPTIONAL in v1) ----------
# The architecture does not call Supabase REST/Auth from the browser (see ADR-001/002). Keep these empty unless a
# future feature (e.g. Realtime for the kitchen board, file storage) needs them.
SUPABASE_URL=                           # [BACKEND-ONLY] https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=                      # [FRONTEND-SAFE once exposed as VITE_SUPABASE_ANON_KEY] RLS denies everything anyway (migration 0002)
SUPABASE_SERVICE_ROLE_KEY=              # [SECRET] bypasses RLS. Backend only. NEVER VITE_*, NEVER committed, NEVER in the frontend bundle.

# ---------- payments ----------
PAYMENT_PROVIDER=mock                   # [BACKEND-ONLY] mock | razorpay (hackathon build uses `mock`, ADR-011)
PAYMENT_PROVIDER_KEY=                   # [SECRET] provider key id (not needed for `mock`)
PAYMENT_PROVIDER_SECRET=                # [SECRET] provider key secret (not needed for `mock`)
PAYMENT_WEBHOOK_SECRET=                 # [SECRET] verifies provider webhooks (not needed for `mock`)

# ---------- frontend (Vite exposes ONLY variables prefixed VITE_) ----------
VITE_API_BASE_URL=http://localhost:4000/api/v1   # [FRONTEND-SAFE] "API_BASE_URL" of the contract
VITE_APP_NAME=The Champions Club        # [FRONTEND-SAFE]
VITE_PAYMENT_PUBLIC_KEY=                # [FRONTEND-SAFE] provider PUBLISHABLE key only (not needed for `mock`)
